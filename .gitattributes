# Normalize line endings to LF in the repository (matches prettier endOfLine: lf)
* text=auto eol=lf
# Binary files - no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary
# Sample e-mails are byte-exact (attachments are checked byte for byte)
*.eml binary
docs/video/*.mp4 filter=lfs diff=lfs merge=lfs -text
